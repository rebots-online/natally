# natally — build-time and script-time configuration. Copy to .env (gitignored).
# Client values are VITE_* and are baked into the bundle at build time.
VITE_MODEL_MIRROR_BASE=https://huggingface.co/RobinsAIWorld/natally-models/resolve/main
VITE_APP_URL=https://natally.robin.mba

# Trial policy (D11). Exactly one gate; baked at build, enforced by the local usage ledger.
VITE_TRIAL_MODE=count            # count | time | rate
VITE_TRIAL_READINGS=3            # count gate: readings allowed
VITE_TRIAL_DAYS=                 # time gate: days from install
VITE_TRIAL_RATE_COOLDOWN_DAYS=3  # rate gate: one reading per N days
VITE_TRIAL_MODEL=                # catalogue id of the single trial-eligible model

# Unlock / processors (D11). Blank or unset = rail hidden at runtime (honest availability line).
VITE_LICENSE_BRIDGE_URL=         # operator-hosted license bridge (checkout URLs, webhooks, license tokens, code registry)
VITE_STRIPE_CHECKOUT_URL=
VITE_REVENUECAT_WEB_SDK_KEY=     # web/PWA paywall; Android uses the native SDK keys in the mobile build
VITE_REVENUECAT_OFFERING_ID=natally_default
VITE_POLAR_CHECKOUT_URL=
VITE_LEMONSQUEEZY_CHECKOUT_URL=
VITE_PAYPAL_CHECKOUT_URL=
VITE_SQUARE_CHECKOUT_URL=

# Lore (D12). 0 disables the subsystem; sizes bound the local vector/graph stores.
VITE_LORE_ENABLED=1
VITE_LORE_EMBED_DIM=384

# Scripts only (never shipped): Hugging Face write token for the frozen model mirror.
HF_TOKEN=

