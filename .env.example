# Build-time and script-time configuration. Copy to .env (gitignored).
# This is the single place for defaults and fork identity. VITE_* values are public
# and baked into the client bundle. Never put script or server secrets in VITE_*.

# Fork branding: display title, reverse-DNS application namespace, artifact basename.
VITE_APP_NAME=natally
VITE_APP_ID=mba.robin.natally
VITE_APP_SLUG=mba.robin.natally
# Shared origin for public unauthenticated HF model downloads (§13).
# Assets carry absolute URLs to their public HF repos; this base defines the
# origin allowlist for MirrorNetwork. No upload, no mirroring, no write token.
VITE_MODEL_MIRROR_BASE=https://huggingface.co
# Deployed web app domain and public landing page (may differ for a fork).
VITE_APP_URL=https://natally.robin.mba
VITE_LANDING_URL=https://natally.robin.mba
# Shared storage scope (§19): public identity for the cross-app asset library.
# Content-addressed; independent of branding, package IDs, developer accounts.
VITE_STORAGE_SCOPE=shared-content-v1
# Vite server configuration only; high development port, not exposed to the browser.
NATALLY_DEV_PORT=46371

# Android release signing (CC11). Values are local credentials and must stay in `.env`.
# The shared production upload key is documented in Admin-Manual/CREDENTIALS/PlayStore/.
NATALLY_ANDROID_KEYSTORE_PATH=
NATALLY_ANDROID_KEYSTORE_PASSWORD=
NATALLY_ANDROID_KEY_ALIAS=
NATALLY_ANDROID_KEY_PASSWORD=

# Trial policy (D11). Exactly one gate; baked at build, enforced by the local usage ledger.
# Exactly the selected mode's positive integer is populated; unused gates stay blank.
VITE_TRIAL_MODE=count           # count | time | rate
VITE_TRIAL_READINGS=3           # count gate: readings allowed
VITE_TRIAL_DAYS=                # time gate: days from install
VITE_TRIAL_RATE_COOLDOWN_DAYS=  # rate gate: one reading per N days
VITE_TRIAL_MODEL=qwen3.5-2b-q4_k_m # required, non-empty catalogue id of the trial model

# Unlock / processors (D11). Blank or unset = rail hidden at runtime (honest availability line).
VITE_LICENSE_BRIDGE_URL=         # operator-hosted license bridge (checkout URLs, webhooks, license tokens, code registry)
VITE_STRIPE_CHECKOUT_URL=
VITE_REVENUECAT_WEB_SDK_KEY=     # web/PWA paywall; Android uses the native SDK keys in the mobile build
VITE_REVENUECAT_OFFERING_ID=natally_default
VITE_POLAR_CHECKOUT_URL=
VITE_LEMONSQUEEZY_CHECKOUT_URL=
VITE_PAYPAL_CHECKOUT_URL=
VITE_SQUARE_CHECKOUT_URL=
# Public verification key for offline licenses; blank until licensing is configured.
# Encoding and signature verification are handled by the licensing module (B.3).
VITE_LICENSE_PUBKEY=

# Lore (D12). 0 disables the subsystem; sizes bound the local vector/graph stores.
VITE_LORE_ENABLED=1
VITE_LORE_EMBED_DIM=384

# Bridge-only signing keys, processor webhook secrets and the code registry belong
# in the bridge host's environment, never here or in any VITE_* variable.
