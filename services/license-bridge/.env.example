# natally — license bridge secrets (.env, gitignored; fed from
# ~/Admin-Manual/CREDENTIALS/natally.md — never commit real values).
# Load with: set -a; . ./.env; set +a

# Ed25519 signing key: base64 of the raw 32-byte seed (§9.3).
LICENSE_ED25519_PRIVATE_KEY=

# RevenueCat keys (§9.4).
RC_SECRET_KEY=
RC_API_KEY=

# The six processor webhook secrets (mapping table in README.md).
STRIPE_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
SQUARE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# SQLite idempotent ledger file (§9.4).
LEDGER_PATH=

# --- optional (defaults in README) ---
#PORT=8088
#STRIPE_TOLERANCE_SECS=300
#RC_API_BASE=https://api.revenuecat.com/v2
#RC_PROJECT_ID=
#RC_ENTITLEMENT_ID=unlimited
