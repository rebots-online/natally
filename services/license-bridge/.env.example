# license-bridge configuration — copy to .env (never committed) and fill with real
# values from the operator's Admin-Manual credentials store. Key names only here.

# Bind address (high, non-patterned port per I-16/INC-11).
BRIDGE_BIND_ADDR=127.0.0.1:47231

# SQLite ledger path (webhook idempotency, minted jti map, revocations, code registry).
BRIDGE_DB_PATH=bridge.sqlite3

# Ed25519 signing seed for license tokens AND the deny-list — 32 bytes, base64 (std).
# The matching public key is baked into clients as VITE_LICENSE_PUBKEY.
LICENSE_ED25519_PRIVATE_KEY=

# Per-processor webhook HMAC secrets (HMAC-SHA256 over the raw body; a blank value
# hides that rail entirely, §9.4).
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
SQUARE_WEBHOOK_SECRET=
